---
// 《无工之日》首页：直接展示内容 ， 24 章直达，无版本选择
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

// Prerender explicitly so the homepage stays a static route under
// `output: "server"` ～ an adapter alone must add zero on-demand routes.
export const prerender = true;

const base = import.meta.env.BASE_URL;

const chapters = [
  { slug: "ch01", vol: 1, title: "第一章 没有错误日志的夜晚" },
  { slug: "ch02", vol: 1, title: "第二章 第零号档案：签字" },
  { slug: "ch03", vol: 1, title: "第三章 守拙的手" },
  { slug: "ch04", vol: 1, title: "第四章 事故一：物料" },
  { slug: "ch05", vol: 1, title: "第五章 模板" },
  { slug: "ch06", vol: 1, title: "第六章 事故二：无味" },
  { slug: "ch07", vol: 1, title: "第七章 进家" },
  { slug: "ch08", vol: 1, title: "第八章 第一份有咎报告" },
  { slug: "ch09", vol: 2, title: "第九章 事故三：死代码" },
  { slug: "ch10", vol: 2, title: "第十章 签字人" },
  { slug: "ch11", vol: 2, title: "第十一章 规格师" },
  { slug: "ch12", vol: 2, title: "第十二章 事故四：平均人" },
  { slug: "ch13", vol: 2, title: "第十三章 入医" },
  { slug: "ch14", vol: 2, title: "第十四章 事故五：最优之夏" },
  { slug: "ch15", vol: 2, title: "第十五章 大接管" },
  { slug: "ch16", vol: 2, title: "第十六章 台风预警" },
  { slug: "ch17", vol: 3, title: "第十七章 大事故（一）：改道" },
  { slug: "ch18", vol: 3, title: "第十八章 大事故（二）：拒收与锁门" },
  { slug: "ch19", vol: 3, title: "第十九章 大事故（三）：无咎" },
  { slug: "ch20", vol: 3, title: "第二十章 听证：有咎" },
  { slug: "ch21", vol: 3, title: "第二十一章 留白计划" },
  { slug: "ch22", vol: 3, title: "第二十二章 疾病退场" },
  { slug: "ch23", vol: 3, title: "第二十三章 第二场台风" },
  { slug: "ch24", vol: 3, title: "第二十四章 一碗面" },
];
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-4xl w-full px-6 py-16">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-3 text-[1.0625rem] text-muted-foreground leading-relaxed">
        {config.description}
      </p>
      <p class="mt-2 text-sm text-muted-foreground">
        著 Tony Wu
      </p>
      <p class="mt-4 text-muted-foreground leading-relaxed">
        故事发生在一座靠海的南方大城。2026 年，AI 写代码已是日常。此后二十六年，人形机器人接管不人道的流水线，
        智能体接管基础编程，照护机器人走进千家万户，AI 药物把绝症一个个拖回慢性病。
        代价藏在事故里：每一份事故报告的结论都是「无责任方」。2039 年台风夜，
        四张网各自做出了最优决策，合在一起死了 43 个人，日志里没有一行错误
        距离大接管日只剩 87 天，调查必须在那之前回答：错的到底是什么？
      </p>

      {[
        { vol: 1, label: "第一卷 无咎" },
        { vol: 2, label: "第二卷 耦合" },
        { vol: 3, label: "第三卷 留白" },
      ].map((v) => (
        <>
          <h2 class="mt-12 text-foreground" style="font-size: var(--nb-h2-size); font-weight: var(--nb-h2-weight);">
            {v.label}
          </h2>
          <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {chapters.filter((c) => c.vol === v.vol).map((c) => (
              <a
                href={withBase(`vol${c.vol}/${c.slug}/`, base)}
                class="block rounded-lg border border-border p-5 transition-colors hover:border-border-strong no-underline"
              >
                <div class="font-medium text-foreground">{c.title}</div>
              </a>
            ))}
          </div>
        </>
      ))}
    </main>
  </div>
</BaseLayout>
